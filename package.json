{
  "name": "ceiba-motor",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "node -e \"process.exit(require('fs').existsSync('apps/sandbox/public/world/manifest.json')?0:1)\" || pnpm world; pnpm --filter @ceiba/sandbox dev",
    "build": "tsc -b",
    "test": "vitest run",
    "lint": "biome check",
    "format": "biome check --write",
    "size": "tsc -b && node scripts/size.js",
    "world": "node tools/worldgen/src/cli.ts --out apps/sandbox/public/world"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  }
}
